{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZONA",
  "version": "0.1.0",
  "identifier": "app.zona.messenger",
  "build": {
    "beforeDevCommand": "pnpm --filter @zona/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @zona/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZONA",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
