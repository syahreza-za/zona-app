{
  "name": "zona-app",
  "version": "0.1.0",
  "private": true,
  "description": "ZONA — Cross-platform Social Hangout & Circle Messenger (WhatsApp × Discord × Snapchat) for Web/PWA, macOS, Windows, iOS, and Android",
  "scripts": {
    "dev:web": "pnpm --filter @zona/web dev",
    "dev:mobile": "pnpm --filter @zona/mobile start",
    "dev:desktop": "pnpm --filter @zona/desktop dev",
    "build:web": "pnpm --filter @zona/web build",
    "build:desktop": "pnpm --filter @zona/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @zona/shared test"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
