# Mode Demo Lokal (true = langsung jalan tanpa kredensial Supabase/LiveKit)
VITE_DEMO_MODE=true
EXPO_PUBLIC_DEMO_MODE=true

# Supabase (isi jika ingin sync cloud realtime & PostGIS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# LiveKit WebRTC (isi untuk Voice Lounge realtime lintas perangkat)
VITE_LIVEKIT_URL=
EXPO_PUBLIC_LIVEKIT_URL=

# MapLibre Style URL (default: OpenFreeMap gratis $0)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
